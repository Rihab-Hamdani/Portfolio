# =====================================================================
# Copy to .env and fill in. NEVER commit .env (it is git-ignored).
# =====================================================================

# ---------- Database ----------
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
# Local development only — use a strong, unique password anywhere else.
POSTGRES_PASSWORD=change-me-local-dev-password
POSTGRES_PORT=5432

# ---------- Security ----------
# At least 32 characters. Generate with:  openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MINUTES=120

# First admin account, created automatically on startup if it does not exist yet.
# Password must be at least 12 characters. You can remove both lines after the first start.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=Rihab Hamdani

# Origins allowed to call the API directly (the Docker frontend uses same-origin /api and does not need this).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------- Public site ----------
# Public URL of the deployed site, e.g. https://rihabhamdani.dev (used for canonical URLs, OG tags, sitemap).
SITE_URL=
# Leave empty until you have the real links — empty links are hidden, never invented.
VITE_GITHUB_URL=
VITE_LINKEDIN_URL=
VITE_EMAIL=
VITE_RESUME_URL=/Rihab-Hamdani-CV.pdf
VITE_PROFILE_PHOTO=/images/profile.jpg

# ---------- Abuse protection ----------
RATE_LIMIT_CONTACT_PER_HOUR=5
RATE_LIMIT_LOGIN_PER_15_MIN=10
RATE_LIMIT_ANALYTICS_PER_MIN=60

# ---------- Optional e-mail notification for new contact messages ----------
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_TO=

# ---------- Ports on your machine ----------
FRONTEND_PORT=3000
BACKEND_PORT=8080
